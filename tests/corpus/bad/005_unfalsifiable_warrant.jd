/**
 * expect: JD-A06
 * The warrant has no observable pass/fail. Nobody can run it and nobody can dispute it,
 * so the argument cannot fail -- which is the only reason to write one.
 * The leaf compounds it: it names nothing inspectable either (JD-G03).
 */
justification unfalsifiable {
    conclusion c is "The classifier is fit for deployment"
    strategy   s is "The approach is methodologically sound and follows best practices"
    evidence   e is "The quality of the engineering work"

    s supports c
    e supports s
}
